# Copy to .env at the repository root and use your device's regional hostname.
BLYNK_SERVER=sgp1.blynk.cloud
BLYNK_AUTH_TOKEN=replace_with_your_device_auth_token

# Optional dynamic provisioning (install Cloud Edge/requirements-mcp-poc.txt first).
# Authorize the standalone Python MCP client before enabling this mode.
BLYNK_PROVISIONING_ENABLED=0
BLYNK_APPROVED_NODES=
BLYNK_PROVISION_SERVER=sgp1.blynk.cloud
