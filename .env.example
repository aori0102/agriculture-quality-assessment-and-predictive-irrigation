# Copy to .env at the repository root. Never commit real tokens.
# Static mode: one entry per existing Blynk Device; omit or use [] for dynamic-only mode.
# Add each static device's numeric "device_id" to enable cross-node dashboard links.
BLYNK_DEVICES_JSON='[{"node_id":"esp01","server":"sgp1.blynk.cloud","auth_token_env":"BLYNK_ESP01_TOKEN"}]'
BLYNK_ESP01_TOKEN=replace_with_existing_device_token

# Optional open enrollment (install Cloud Edge/requirements-mcp-poc.txt first).
# Accepted telemetry from any valid Node ID may create a Blynk Device.
# Authorize the standalone Python MCP client before enabling this mode.
BLYNK_PROVISIONING_ENABLED=1
BLYNK_PROVISION_SERVER=sgp1.blynk.cloud
