# Add these entries to the repository-root .env or process environment.
# Documentation only: Cloud does not load Cloud/.env automatically.
# Replace placeholders privately. Never commit actual device tokens.
BLYNK_DEVICES_JSON='[{"node_id":"node-1","server":"sgp1.blynk.cloud","auth_token_env":"BLYNK_NODE_1_TOKEN"},{"node_id":"node-2","server":"sgp1.blynk.cloud","auth_token_env":"BLYNK_NODE_2_TOKEN"}]'
BLYNK_NODE_1_TOKEN=replace_with_first_device_token
BLYNK_NODE_2_TOKEN=replace_with_second_device_token
